# ==============================================================================
# RAWAD TECH CAPTIVE PORTAL — ISOLATED FIELD-TEST ENVIRONMENT TEMPLATE
# SAFE FOR LOCAL / LAB TESTING ONLY — NEVER USE IN PRODUCTION!
# ==============================================================================

NODE_ENV=development
FIELD_TEST_MODE=true
MIKROTIK_MODE=mock

# Backend HTTP bind (local loopback only)
HOST=127.0.0.1
PORT=4000

# Local / Ephemeral Test Supabase or PostgREST URL (NEVER *.supabase.co in FIELD_TEST_MODE)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=FIELD_TEST_DUMMY_SERVICE_ROLE_KEY_NOT_FOR_PROD

# Test-only signing secret (NEVER use in production)
TOKEN_SECRET=field-test-only-token-secret-do-not-use-in-production-0000

# Mock MikroTik settings (never connects to physical router)
MIKROTIK_HOST=mock.local
MIKROTIK_REST_PORT=443
MIKROTIK_API_USER=mock-api
MIKROTIK_API_PASSWORD=FIELD_TEST_DUMMY_MIKROTIK_PASSWORD
MIKROTIK_TLS_VERIFY=false
MIKROTIK_HOTSPOT_SERVER=rawad-guest-hotspot

# Quota & Monitor timings
FREE_QUOTA_SECONDS=1800
SESSION_SYNC_INTERVAL_MS=5000

# Origins (local loopback only)
GUEST_PORTAL_ORIGIN=http://127.0.0.1:3000
ADMIN_DASHBOARD_ORIGIN=http://127.0.0.1:3001
TRUST_PROXY=false
ALLOW_DEV_MAC_FALLBACK=true

# Test Admin credentials
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=FieldTest@2026!
