# Rawad Tech Captive Portal - Production Environment Template
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=true
TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64_CHARS

# Supabase PostgreSQL (HTTPS — Backend ONLY, never expose in Frontend!)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# MikroTik Mode: 'mock' for local testing, 'rest' for production RouterOS v7
MIKROTIK_MODE=rest
MIKROTIK_HOST=192.168.20.1
MIKROTIK_REST_PORT=443
MIKROTIK_API_USER=rawad-api
MIKROTIK_API_PASSWORD=REPLACE_WITH_API_PASSWORD
MIKROTIK_TLS_VERIFY=true
MIKROTIK_CA_CERT_PATH=/app/certs/rawad-ca.crt
MIKROTIK_HOTSPOT_SERVER=rawad-guest-hotspot

# Free Quota (30 minutes = 1800 seconds) & Sync
FREE_QUOTA_SECONDS=1800
SESSION_SYNC_INTERVAL_MS=5000

# Network Bindings & Origins (MUST use explicit server IP and real company-owned domain)
STAFF_BIND_IP=127.0.0.1
GUEST_PROXY_BIND_IP=192.168.10.10
GUEST_PORTAL_ORIGIN=https://wifi.YOUR_COMPANY_DOMAIN.com
ADMIN_DASHBOARD_ORIGIN=https://127.0.0.1:8443
NEXT_PUBLIC_API_URL=

# Default Admin (MUST be set to a strong unique password in production)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
