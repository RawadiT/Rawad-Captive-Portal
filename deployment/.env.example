# Rawad Tech Captive Portal - Production Environment Template
NODE_ENV=production
PORT=4000
HOST=127.0.0.1
TRUST_PROXY=true
TOKEN_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_64_CHARS

# MikroTik Mode: 'mock' for local testing, 'rest' for production RouterOS 7.x
MIKROTIK_MODE=rest
MIKROTIK_HOST=192.168.10.1
MIKROTIK_REST_PORT=443
MIKROTIK_API_USER=rawad-api
MIKROTIK_API_PASSWORD=REPLACE_WITH_API_PASSWORD
MIKROTIK_TLS_VERIFY=true
MIKROTIK_CA_CERT_PATH=/app/certs/rawad-ca.crt
MIKROTIK_HOTSPOT_SERVER=rawad-guest-hotspot
MIKROTIK_PROFILE_FREE=rawad-free-30m
MIKROTIK_PROFILE_USER=rawad-user

# Quotas & Sync
FREE_QUOTA_SECONDS=1800
SESSION_SYNC_INTERVAL_MS=5000

# Network Bindings & Origins (MUST use real company-owned domain, never mDNS/private suffix)
STAFF_BIND_IP=127.0.0.1
GUEST_PROXY_BIND_IP=0.0.0.0
GUEST_PORTAL_ORIGIN=https://wifi.YOUR_COMPANY_DOMAIN.com
ADMIN_DASHBOARD_ORIGIN=https://127.0.0.1:8443
NEXT_PUBLIC_API_URL=

# Default Super Admin (MUST be set to a strong unique password in production)
DEFAULT_SUPER_ADMIN_USER=superadmin
DEFAULT_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_SUPERADMIN_PASSWORD
